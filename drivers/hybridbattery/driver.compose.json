{
  "name": {
    "en": "Battery - Hybrid Inverter",
    "nl": "Batterij - Hybride Omvormer"
  },
  "images": {
    "large": "/drivers/hybridbattery/assets/images/large.jpg",
    "small": "/drivers/hybridbattery/assets/images/small.jpg"
  },
  "connectivity": [
    "lan"
  ],
  "platforms": [
    "local"
  ],
  "class": "battery",
  "energy": {
    "homeBattery": true,
    "meterPowerImportedCapability": "meter_power.imported",
    "meterPowerExportedCapability": "meter_power.exported"
  },
  "pair": [
    {
      "id": "pair"
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "capabilities": [
    "measure_power",
    "battery_soc",
    "battery_soc.health",
    "measure_temperature",
    "measure_voltage",
    "measure_current",
    "measure_current.charge_limit",
    "measure_current.discharge_limit",
    "measure_power.eps",
    "meter_power.imported",
    "meter_power.exported",
    "meter_power.battery_charge_today",
    "meter_power.battery_discharge_today",
    "meter_power.eps_today",
    "meter_power.eps_total"
  ],
  "capabilitiesOptions": {
    "measure_power": {
      "title": {
        "en": "Battery Power (W)",
        "nl": "Batterijvermogen (W)"
      }
    },
    "battery_soc": {
      "title": {
        "en": "Battery Charge Level (%)",
        "nl": "Batterij Laadniveau (%)"
      }
    },
    "battery_soc.health": {
      "title": {
        "en": "Battery State of Health (%)",
        "nl": "Batterijconditie (%)"
      }
    },
    "measure_temperature": {
      "title": {
        "en": "Battery Temperature",
        "nl": "Batterijtemperatuur"
      }
    },
    "measure_voltage": {
      "title": {
        "en": "Battery Voltage",
        "nl": "Batterijspanning"
      }
    },
    "measure_current": {
      "title": {
        "en": "Battery Current",
        "nl": "Batterijstroom"
      }
    },
    "measure_current.charge_limit": {
      "title": {
        "en": "Battery Charge Current Limit",
        "nl": "Batterij Laadstroomlimiet"
      }
    },
    "measure_current.discharge_limit": {
      "title": {
        "en": "Battery Discharge Current Limit",
        "nl": "Batterij Ontlaadstroomlimiet"
      }
    },
    "measure_power.eps": {
      "title": {
        "en": "EPS Output Power",
        "nl": "EPS Uitgangsvermogen"
      }
    },
    "meter_power.imported": {
      "title": {
        "en": "Battery Charged Energy",
        "nl": "Batterij Opgeladen Energie"
      }
    },
    "meter_power.exported": {
      "title": {
        "en": "Battery Discharged Energy",
        "nl": "Batterij Ontladen Energie"
      }
    },
    "meter_power.battery_charge_today": {
      "title": {
        "en": "Battery Charged Today (kWh)",
        "nl": "Batterij Opgeladen Vandaag (kWh)"
      }
    },
    "meter_power.battery_discharge_today": {
      "title": {
        "en": "Battery Discharged Today (kWh)",
        "nl": "Batterij Ontladen Vandaag (kWh)"
      }
    },
    "meter_power.eps_today": {
      "title": {
        "en": "EPS Energy Today (kWh)",
        "nl": "EPS Energie Vandaag (kWh)"
      }
    },
    "meter_power.eps_total": {
      "title": {
        "en": "EPS Energy Lifetime (kWh)",
        "nl": "EPS Energie Totaal (kWh)"
      }
    }
  },
  "settings": [
    {
      "id": "ip_address",
      "type": "text",
      "label": {
        "en": "SolPlanet inverter IP address or URL"
      }
    },
    {
      "id": "device_serial_number",
      "type": "text",
      "label": {
        "en": "Device serial number (can be found at the online dashboard)"
      }
    },
    {
      "id": "interval",
      "type": "number",
      "value": 60,
      "min": 5,
      "max": 300,
      "label": {
        "en": "Fetch interval (in seconds)"
      }
    },
    {
      "id": "solplanet_model_label",
      "type": "label",
      "label": {
        "en": "Model name"
      },
      "value": ""
    },
    {
      "id": "solplanet_battery_model_label",
      "type": "label",
      "label": {
        "en": "Battery model"
      },
      "value": ""
    }
  ]
}
